include README.md
include LICENSE
include rum/bin/*.dll
include rum/py.typed
include rum/emojis.json

# setup.py reads the project metadata from README.md via scripts/readme_metadata.py
recursive-include scripts *.py

prune .github
prune docs
prune examples
prune tests
exclude rum/bin/COPYING
exclude .flake8
exclude .gitignore
exclude .pre-commit-config.yaml
exclude .prettierrc
exclude CHANGELOG.md
exclude FUNDING.yml
